# Aplica a todo el proyecto: backend-nest/ y front-react/.
# Cada subproyecto tiene ademas su propio .gitignore por si se separan en repos.

# --- Dependencias -----------------------------------------------------------
node_modules/
.pnp
.pnp.js
.npm
.yarn/

# --- Salidas de compilacion -------------------------------------------------
dist/
dist-ssr/
build/
*.tsbuildinfo

# --- Variables de entorno ---------------------------------------------------
# Traen credenciales (JWT_SECRET, claves de Stripe y Gemini). Se versionan solo
# las plantillas: .env.example y front-react/.env.production.
.env
.env.local
.env.*.local
!.env.example

# --- Archivos subidos en tiempo de ejecucion --------------------------------
# Fotos cargadas desde la app. Las imagenes de `backend-nest/seed/` SI se
# versionan: son la fuente del seeder.
backend-nest/uploads/

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Tests y cobertura ------------------------------------------------------
coverage/
.nyc_output/

# --- Cache de herramientas --------------------------------------------------
.cache/
.temp/
.tmp/
.eslintcache
.vite/

# --- Datos de ejecucion -----------------------------------------------------
pids/
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Editores ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Docker -----------------------------------------------------------------
# Sobrecargas locales de compose (docker-compose.override.yml se aplica solo).
docker-compose.override.yml
docker-compose.override.yaml
