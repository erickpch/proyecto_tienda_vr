# Variables del docker-compose de la raiz (API + frontend + PostgreSQL).
# Copiar a `.env` antes de levantar: cp .env.example .env

# --- Puertos publicados en la maquina --------------------------------------
WEB_PORT=8080
API_PORT=3000
DB_PORT=5435
PGADMIN_PORT=5050

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tiendavr

# --- pgAdmin (consola web de la base) ---------------------------------------
# Entra sin login. Al abrir un servidor pide la password: es POSTGRES_PASSWORD.
PGADMIN_EMAIL=admin@tienda.com
PGADMIN_PASSWORD=admin123

# --- Seguridad (obligatorio) -----------------------------------------------
# Generar uno: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# --- Usuario administrador -------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_CORREO=admin@tienda.com
ADMIN_PASSWORD=admin123

# --- Seeder ----------------------------------------------------------------
# SEED_DEMO=false -> solo roles y administrador, sin catalogo de prueba.
# SEED_FORZAR=true -> vuelve a sembrar aunque ya haya productos.
SEED_DEMO=true
SEED_FORZAR=false
SEED_PASSWORD=demo1234

# --- Subida de archivos ----------------------------------------------------
MAX_UPLOAD_MB=5

# --- Frontend (se congelan al construir la imagen) --------------------------
# /api hace que nginx proxee a la API. Para apuntar a otro host: http://mi-api:3000
VITE_API_URL=/api
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Stripe (backend) ------------------------------------------------------
# Vacio = el checkout cae al pago simulado por QR.
STRIPE_SECRET_KEY=
STRIPE_MONEDA=usd
STRIPE_TASA_BOB=6.96
STRIPE_MINIMO_CENTAVOS=50

# --- Gemini (asistente IA) -------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IA_HABILITADA=true
IA_CONSULTAS_POR_HORA=30

# --- Reservas --------------------------------------------------------------
RESERVA_HORAS_VIGENCIA=24
